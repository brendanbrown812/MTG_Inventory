# Copy this file to .env and fill in your values.
# docker-compose will automatically load .env from the project root.

# The URL(s) your browser uses to reach Spellbinder (comma-separated, no trailing slash).
# Must include your Cloudflare Tunnel domain once you have one.
# Example: CORS_ORIGINS=http://192.168.1.50:8888,https://spellbinder.yourdomain.com
CORS_ORIGINS=http://localhost:8888

# Host port to expose the app on (default: 8888)
PORT=8888

# Required when CORS_ORIGINS contains a non-local address unless an upstream
# service such as Cloudflare Access authenticates every request.
APP_API_KEY=
REQUIRE_AUTH=true
EXTERNAL_AUTH_ENABLED=false

# Deck construction uses OpenAI strategic reasoning when this key is set and
# automatically falls back to deterministic local reasoning when it is absent
# or the request fails. Never commit your real key.
OPENAI_API_KEY=
OPENAI_REQUESTS_ENABLED=false
OPENAI_MONTHLY_BUDGET_USD=1.00
OPENAI_SINGLE_REQUEST_LIMIT_USD=0.10
REASONING_PROVIDER=openai
REASONING_MODEL=gpt-5.6-luna
REASONING_EFFORT=medium
REASONING_MAX_OUTPUT_TOKENS=6000
REVIEW_PROVIDER=openai
REVIEW_MODEL=gpt-5.6-luna
REVIEW_REASONING_EFFORT=low
REVIEW_MAX_OUTPUT_TOKENS=4000
REVIEW_FALLBACK_MODEL=rules-v1
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
ENRICHMENT_PROVIDER=openai
ENRICHMENT_MODEL=gpt-5.6-luna
ENRICHMENT_REASONING_EFFORT=low
ENRICHMENT_MAX_OUTPUT_TOKENS_PER_CARD=900
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_REQUEST_BATCH_SIZE=100

# Anthropic remains optional only when explicitly selecting an Anthropic
# enrichment or build-strategy provider.
ANTHROPIC_API_KEY=
